{
  "name": "poorup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "test": "node scripts/run-test-manifest.mjs --group=core",
    "test:audit": "node scripts/run-test-manifest.mjs --group=audit",
    "test:bot-timing": "node server/botTiming.test.js && node server/socketRuntime.test.js",
    "test:full": "node scripts/run-test-manifest.mjs --group=full",
    "lint": "eslint server scripts qa --max-warnings 3",
    "lint:client": "eslint public",
    "bot:compare": "node server/bot-policy-tournament.js",
    "coverage": "c8 --include=\"server/**\" --reporter=text --reporter=lcov node scripts/run-test-manifest.mjs --group=full",
    "test:browser": "playwright test -c qa/playwright.config.js",
    "capture:ui": "node scripts/capture-ui.mjs",
    "load:testing": "node qa/load/poorup-socket-load.mjs",
    "test:account": "node scripts/run-test-manifest.mjs --group=account",
    "test:inactivity": "node scripts/run-test-manifest.mjs --group=inactivity",
    "test:bot-campaign": "node server/bot-simulation.test.js",
    "timings:refresh": "node scripts/refresh-test-timings.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.4"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": "22.x"
  }
}
