# Copy to the host env file (the deploy reads it through scripts/loadEnvFile.cjs,
# which follows bash `source` rules for KEY=VALUE lines). Quote any value that
# contains spaces, #, $, ;, &, ?, *, ~ or quotes, for example:
#   POORUP_MAIL_FROM="Poorup <no-reply@poorup.tech>"
# Lines with `export` are accepted. An inline comment must follow whitespace.
NODE_ENV=development
PORT=8080
POORUP_ALLOWED_ORIGINS=http://localhost:8080
# Data and backup directories. Production (NODE_ENV=production) refuses to
# start unless both are absolute paths outside the application directory, for
# example /var/lib/poorup and /var/backups/poorup. Relative values are only
# for local development and are resolved to absolute paths at boot.
POORUP_DATA_DIR=./server/data
POORUP_BACKUP_DIR=./server/backups
# Backup copy interval (default 15 minutes). Retention is tiered: the newest 7
# verified copies, one per hour for 48 hours, and one per day for 30 days.
POORUP_BACKUP_INTERVAL_MS=900000
POORUP_HTTP_RATE_LIMIT=240
POORUP_HTTP_RATE_WINDOW_MS=60000
POORUP_SOCKET_RATE_LIMIT=120
POORUP_SOCKET_RATE_WINDOW_MS=60000
# Socket admission (optional; built-in defaults apply when unset).
# POORUP_SOCKET_MAX_CONNECTIONS=
# POORUP_SOCKET_HANDSHAKE_RATE=
# POORUP_SOCKET_HANDSHAKE_WINDOW_MS=
POORUP_TRUST_PROXY_HOPS=0
POORUP_RELEASE_ID=local
POORUP_MAINTENANCE_MODE=normal
POORUP_MAINTENANCE_TOKEN=
# Operator password for the maintenance lockout panel. Unset: no password
# sign-in (admin accounts still bypass the lockout). The cookie secret is
# optional (unset = random per process, so a restart signs operators out);
# the access lifetime defaults to 12 hours.
POORUP_MAINTENANCE_PASSWORD=
# POORUP_MAINTENANCE_COOKIE_SECRET=
# POORUP_MAINTENANCE_ACCESS_TTL_MS=43200000
# Optional social-preview overrides; unset keeps the built-in values.
# POORUP_META_DESCRIPTION=
# POORUP_PREVIEW_PATH=
# Public origin of the live site, for example https://poorup.tech. Account
# recovery mail links and the sitemap are built from it; unset means recovery
# mail carries no usable link.
# POORUP_PUBLIC_ORIGIN=
# Search indexing stays closed unless POORUP_PUBLIC_ORIGIN is set AND this is
# exactly index,follow. Any other value keeps robots.txt disallowing everything.
# POORUP_INDEX_POLICY=
# Optional search-engine ownership tokens (the content value only, no tag).
# POORUP_GOOGLE_SITE_VERIFICATION=
# POORUP_BING_SITE_VERIFICATION=
POORUP_ADMIN_ACCOUNT_IDS=
POORUP_PERSISTENCE_ADAPTER=json
# AI provider + mail + cookie + analytics secrets (all required in prod;
# memory-only providers and broken mail otherwise).
POORUP_AI_CONFIG_KEY=
POORUP_AI_API_KEY=
POORUP_AI_MODEL=deepseek-chat
# Optional provider overrides (default: the DeepSeek endpoint, protocol auto).
# POORUP_AI_BASE_URL=
# POORUP_AI_PROTOCOL=auto
# Private (loopback or internal) AI endpoints are refused in production. Leave
# POORUP_AI_ALLOW_PRIVATE unset on the live host. POORUP_AI_ALLOW_PRIVATE_ENDPOINTS
# is a deprecated alias: it still counts and logs one warning.
# POORUP_AI_ALLOW_PRIVATE=
# POORUP_AI_ALLOW_PRIVATE_ENDPOINTS=
# Process-wide cap on paid AI calls per rolling hour, across every game (C35-05).
# Unset uses the built-in default of 6000.
# POORUP_AI_CALLS_PER_HOUR=6000
POORUP_MAIL_API_URL=
POORUP_MAIL_API_KEY=
POORUP_MAIL_FROM=
POORUP_COOKIE_SECURE=true
POORUP_ANALYTICS_PSEUDONYM_KEY=
# Bot brains: no-ai (Easy) | ai (Medium) | all (Hard, full stack + advisor).
# Difficulty stays a per-room setting (house | table | expert).
POORUP_BOT_BRAIN=ai
POORUP_AI_MAX_TOKENS=500
POORUP_AI_TIMEOUT_MS=4000
# Drain deadline for graceful shutdown (honored by server.js).
POORUP_SHUTDOWN_DRAIN_MS=15000
POORUP_HORIZONTAL_SCALE=false
# Retention tuning. The retention job runs every 24h by default and prunes
# analytics older than 365d. POORUP_RETENTION_BACKUPS_MS caps backup-copy age
# (default 30d); copies within that age follow the tiered backup policy above.
# POORUP_RETENTION_INTERVAL_MS=86400000
# POORUP_RETENTION_ANALYTICS_MS=31536000000
# POORUP_RETENTION_BACKUPS_MS=2592000000
# Token for POST /internal/retention/run. Unset, it falls back to
# POORUP_MAINTENANCE_TOKEN.
# POORUP_RETENTION_TOKEN=
# Required with POORUP_HORIZONTAL_SCALE=true after the PostgreSQL migration.
# POORUP_POSTGRES_URL=postgres://user:password@host:5432/poorup
