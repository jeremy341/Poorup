# Live data, backups, and secrets must never reach an image layer: the stores
# hold scrypt verifiers, session records and encrypted AI keys.
server/data
server/backups
.env*
docs/ops
.git
.github
node_modules
qa-artifacts
qa/test-results
coverage
.nyc_output
.test-timings
playwright-report
blob-report
test-results

# Tests are never served or needed at runtime.
public/**/*.test.js
server/**/*.test.js
